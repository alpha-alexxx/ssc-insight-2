{
  "name": "ssc-insight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate && node scripts/fix-duo-icons.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "verify:neon": "node scripts/verify-neon.mjs"
  },
  "dependencies": {
    "@duo-icons/react": "^1.0.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-query-devtools": "^5.105.0",
