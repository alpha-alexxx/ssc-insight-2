DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.build/DB/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Enable after configuring your own Google OAuth client in Neon Auth.
GOOGLE_AUTH_ENABLED=false
