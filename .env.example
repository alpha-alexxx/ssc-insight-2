DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.REGION.aws.neon.build/DB/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Enable after configuring your own Google OAuth client in Neon Auth.
GOOGLE_AUTH_ENABLED=false

# Optional AI coach. Set AI_API_KEY and AI_MODEL to enable it; leaving either
# blank keeps the rest of the app working with AI hidden.
# OpenAI-compatible endpoint. Localhost/127.0.0.1 HTTP is allowed for local
# development only. A localhost URL is not reachable from Vercel.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Some compatible providers reject response_format; set to false for those.
AI_JSON_MODE=true
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=300000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=45000



# Required only if users may enter their own API key in the web UI
# (Settings -> AI provider, or inside the AI panel).
#
# This secret encrypts those keys with AES-256-GCM before they are stored, so a
# database-only leak yields ciphertext. Use 64 hex characters (openssl rand
# -hex 32) or a >=32-character passphrase. Losing it makes every stored
# credential unreadable; rotating it requires re-entering each key.
#
# Leaving this blank is safe: AI then works only from the AI_API_KEY above, and
# the in-app credential form reports that storage is unavailable.
AI_CREDENTIAL_SECRET=

# Scheduled Trash cleanup. `vercel.json` points a daily cron at
# /api/cron/trash-cleanup; Vercel sends this value as `Authorization: Bearer
# <CRON_SECRET>`. Generate one with `openssl rand -hex 32`.
#
# Leaving this blank is safe but disables physical cleanup: the endpoint
# answers 503 and expired Trash rows simply stay on disk. Restoring and
# listing them is already blocked by the API once the 15-day window closes,
# so the only consequence is storage, never a wrong answer.
#
# Any external scheduler can drive the same endpoint with the same header.
CRON_SECRET=
