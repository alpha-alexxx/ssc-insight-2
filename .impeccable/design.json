  "narrative": {
    "dos": [
      "Do keep labels, legends, and units visible beside metrics.",
      "Do preserve the divided stat strip and horizontal table scrolling.",
      "Do use semantic paper, ink, accent, and chart variables."
    ],
    "overview": "The approved visual direction is warm editorial paper: cream canvas, paper surfaces, serif headings, quiet sans-serif controls, and terracotta actions. Thin rules organize the working dashboard with the clarity of a printed progress ledger. Anthropic was a visual reference, not a brand identity to reproduce.",
    "rules": [
      {
        "name": "The Meaning Rule",
        "section": "colors",
        "body": "Keep legends, units, and text labels alongside color; color alone must not carry a result's meaning."
      },
      {
        "name": "The Readable Table Rule",
        "section": "layout",
        "body": "Keep wide tables inside their horizontal scroll container. Preserve comparable columns and nowrap values instead of squeezing them into unreadable cells."
      }
    ],
    "donts": [
      "Don't add rounded dashboard cards or colorful icon tiles.",
      "Don't introduce paper textures or heavy shadows.",
      "Don't animate charts or ignore reduced-motion preferences."
    ],
    "keyCharacteristics": [
      "Warm flat surfaces with square corners and thin rules.",
      "Expressive serif headings paired with compact sans-serif controls.",
      "A divided metric strip and coordinated earthy charts."
    ]
  }
