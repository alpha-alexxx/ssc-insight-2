generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ssc_insight"]
}

enum MockType {
  full
  subject
  sectional

  @@schema("ssc_insight")
}

enum SubjectId {
  quant
  reasoning
  english
  ga
  computer

  @@schema("ssc_insight")
}

enum ImportSource {
  manual
  paste
  backup

  @@schema("ssc_insight")
}

enum AiFeature {
  coach
  chat
  extract

  @@schema("ssc_insight")
}

enum AiUsageStatus {
  pending
  success
  error
  aborted

  @@schema("ssc_insight")
}

model MockAttempt {
  id                 String          @id @default(uuid())
  userId             String
  name               String          @db.VarChar(150)
  platform           String          @db.VarChar(80)
  completedAt        DateTime        @db.Timestamptz(3)
  type               MockType
  scoreOverride      Float?
  overallTimeSeconds Int?
  rank               Int?
  participants       Int?
  percentile         Float?
  notes              String          @default("") @db.VarChar(5000)
  source             ImportSource    @default(manual)
  schemaVersion      Int             @default(1)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  subjects           SubjectResult[]

  @@index([userId, completedAt])
  @@index([userId, platform, completedAt])
  @@index([userId, type, completedAt])
  @@schema("ssc_insight")
}

model SubjectResult {
  attemptId     String
  subjectId     SubjectId
  position      Int
  questions     Int
  correct       Int
  incorrect     Int
  scoreOverride Float?
  timeSeconds   Int?
  attempt       MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, subjectId])
  @@unique([attemptId, position])
  @@index([subjectId, attemptId])
  @@schema("ssc_insight")
}

model TrackerSettings {
  userId      String @id
  targetScore Float?

  @@schema("ssc_insight")
}

// AI usage is an app-owned audit/quota ledger. It contains no prompts,
// responses, or attempt content, and is never included in JSON backups.
model AiUsage {
  id             String        @id @default(uuid())
  userId         String
  day            String        @db.VarChar(10)
  feature        AiFeature
  model          String        @db.VarChar(120)
  status         AiUsageStatus @default(pending)
  providerCalls  Int           @default(0)
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  tokensCharged  Int
  contextVersion String?       @db.VarChar(64)
  errorCode      String?       @db.VarChar(64)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  settledAt      DateTime?     @db.Timestamptz(3)

  @@index([userId, day])
  @@index([userId, status, createdAt])
  @@schema("ssc_insight")
}
