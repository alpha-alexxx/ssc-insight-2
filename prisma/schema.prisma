generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["ssc_insight"]
}

enum MockType {
  full
  subject
  sectional

  @@schema("ssc_insight")
}

enum SubjectId {
  quant
  reasoning
  english
  ga
  computer

  @@schema("ssc_insight")
}

enum ImportSource {
  manual
  paste
  backup

  @@schema("ssc_insight")
}

enum AiFeature {
  todos
  coach
  chat
  extract

  @@schema("ssc_insight")
}

enum AiUsageStatus {
  pending
  success
  error
  aborted

  @@schema("ssc_insight")
}

model MockAttempt {
  id                 String          @id @default(uuid())
  userId             String
  name               String          @db.VarChar(150)
  platform           String          @db.VarChar(80)
  completedAt        DateTime        @db.Timestamptz(3)
  type               MockType
  // Which exam and tier/paper this attempt belongs to ("cgl"/"chsl"/"cpo"
  // or a CustomExam id; tier "tier1"/"tier2"/"paper1"/"paper2"/"main").
  examId             String          @default("cgl") @db.VarChar(40)
  tierId             String          @default("tier2") @db.VarChar(40)
  // Marking scheme snapshot of the tier pattern at entry time — the record
  // stays self-contained if the catalog or a custom exam changes later.
  markingCorrect     Float           @default(3)
  markingIncorrect   Float           @default(1)
  scoreOverride      Float?
  overallTimeSeconds Int?
  rank               Int?
  participants       Int?
  percentile         Float?
  notes              String          @default("") @db.VarChar(5000)
  source             ImportSource    @default(manual)
  schemaVersion      Int             @default(2)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  subjects           SubjectResult[]

  @@index([userId, completedAt])
  @@index([userId, platform, completedAt])
  @@index([userId, type, completedAt])
  @@index([userId, examId, completedAt])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "MockAttempt_name_trgm_idx")
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "MockAttempt_notes_trgm_idx")
  @@schema("ssc_insight")
}

model SubjectResult {
  attemptId     String
  subjectId     SubjectId
  position      Int
  questions     Int
  correct       Int
  incorrect     Int
  // Qualifying subjects are excluded from a full mock's merit total
  // (e.g. Computer Knowledge in CGL Tier 2).
  qualifying    Boolean @default(false)
  scoreOverride Float?
  timeSeconds   Int?
  attempt       MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, subjectId])
  @@unique([attemptId, position])
  @@index([subjectId, attemptId])
  @@schema("ssc_insight")
}

// User-defined exams: name + subject slots (canonical SubjectIds) + marking.
// One implicit tier ("main"). Attempts reference the row id as their examId.
model CustomExam {
  id        String   @id @default(uuid())
  userId    String
  name      String   @db.VarChar(80)
  subjects  Json
  marking   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@schema("ssc_insight")
}

// Per-user workspace scope: which built-in exams are enabled, which exam is
// active, and one target score per exam. One row per user.
model TrackerSettings {
  userId       String @id
  activeExamId String @default("cgl") @db.VarChar(40)
  enabledExams Json   @default("[\"cgl\"]")
  examTargets  Json   @default("{}")

  @@schema("ssc_insight")
}

// AI usage is an app-owned audit/quota ledger. It contains no prompts,
// responses, or attempt content, and is never included in JSON backups.
model AiUsage {
  id             String        @id @default(uuid())
  userId         String
  day            String        @db.VarChar(10)
  feature        AiFeature
  model          String        @db.VarChar(120)
  status         AiUsageStatus @default(pending)
  providerCalls  Int           @default(0)
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  tokensCharged  Int
  contextVersion String?       @db.VarChar(64)
  errorCode      String?       @db.VarChar(64)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  settledAt      DateTime?     @db.Timestamptz(3)

  @@index([userId, day])
  @@index([userId, status, createdAt])
  @@schema("ssc_insight")
}

// Per-user AI provider credentials. The API key is encrypted with
// AES-256-GCM under AI_CREDENTIAL_SECRET before it is written here, so a
// database-only leak yields ciphertext. Rows are excluded from JSON backups
// and are never returned to a client in plaintext.
model AiCredential {
  userId       String   @id
  provider     String   @db.VarChar(40)
  baseUrl      String   @db.VarChar(300)
  model        String   @db.VarChar(120)
  apiKeyEnc    String   @db.Text
  keyHint      String   @default("") @db.VarChar(8)
  jsonMode     Boolean  @default(true)
  allowHttp    Boolean  @default(false)
  allowPrivate Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@schema("ssc_insight")
}

// Study-planner progress. The 50-day plan itself is static source data
// (src/data/study-plan.json); these rows hold ONLY user progress, keyed by
// deterministic plan identities (taskKey "d{day}:{taskIndex}", plan day
// number) so completing work never rewrites the schedule.
model PlanTaskProgress {
  id          String   @id @default(uuid())
  userId      String
  taskKey     String   @db.VarChar(20)
  completed   Boolean  @default(false)
  score       Int?
  percentile  Float?
  wrong       Int?
  unattempted Int?
  rev1        Boolean  @default(false)
  rev2        Boolean  @default(false)
  rev3        Boolean  @default(false)
  notes       String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, taskKey])
  @@index([userId])
  @@schema("ssc_insight")
}

model PlanDayProgress {
  id            String   @id @default(uuid())
  userId        String
  day           Int
  checklistDone String[] @default([])
  revisionDone  String[] @default([])
  dayNotes      String?  @db.VarChar(2000)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, day])
  @@index([userId])
  @@schema("ssc_insight")
}

// User-created tasks, independent of the plan. Plan-derived work is NOT
// duplicated here — it is derived from plan + progress at read time.
model PersonalTask {
  id        String   @id @default(uuid())
  userId    String
  title     String   @db.VarChar(200)
  notes     String?  @db.VarChar(2000)
  dueDate   String?  @db.VarChar(10)
  url       String?  @db.VarChar(2048)
  category  String   @db.VarChar(40)
  priority  String   @db.VarChar(20)
  status    String   @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  groupId String?
  group TodoGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subtasks Json @default("[]")
  deletedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, deletedAt, dueDate])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "PersonalTask_title_trgm_idx")
  @@index([notes(ops: raw("gin_trgm_ops"))], type: Gin, map: "PersonalTask_notes_trgm_idx")
  @@schema("ssc_insight")
}

model TodoGroup {
 id String @id @default(uuid())
 userId String
 name String @db.VarChar(80)
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 tasks PersonalTask[]
 @@unique([userId,name])
 @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "TodoGroup_name_trgm_idx")
 @@schema("ssc_insight")
}
model TodoMutation {
 id String @id @default(uuid())
 userId String
 key String @db.VarChar(100)
 payloadHash String
 result Json
 createdAt DateTime @default(now()) @db.Timestamptz(3)
 @@unique([userId,key])
 @@schema("ssc_insight")
}
